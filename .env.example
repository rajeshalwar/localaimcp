# Register a free key at https://developer.nlr.gov/signup/
# Do NOT use DEMO_KEY -- its rate limit is low enough to break a rehearsal.
NREL_API_KEY=your_key_here

# --- model -----------------------------------------------------------------
# 7b is the default on CORRECTNESS grounds, not speed. 3b is ~2.6x faster and
# fine with TOOL_PROFILE=composite, but on the granular path it fabricates
# coordinates or skips tools entirely. Run `make bench` on your own machine.
MODEL_NAME=qwen2.5:7b-instruct
# MODEL_NAME=qwen2.5:3b-instruct   # composite profile only

OLLAMA_KEEP_ALIVE=-1          # keep the model resident; avoids 6-8s cold loads
OLLAMA_NUM_CTX=8192           # Ollama's 4096 default silently truncates tools
OLLAMA_NUM_PREDICT=350        # cap on the final narration
OLLAMA_TOOL_NUM_PREDICT=700   # cap on tool-selection turns; prevents runaways
OLLAMA_TIMEOUT=240            # seconds per Ollama request

# --- wiring ----------------------------------------------------------------
OLLAMA_HOST=http://ollama:11434
MCP_URL=http://appliance:8000/mcp
# Extra hostnames allowed in the Host header (DNS-rebinding protection).
MCP_ALLOWED_HOSTS=

# --- behaviour -------------------------------------------------------------
# These two are read by the MCP server: change them with `make up`, not `make demo`.
TOOL_PROFILE=all              # granular | composite | all
REPLAY_ONLY=false             # true = never touch the network; cache or fail
DEFAULT_RATE_PER_KWH=0.15
SESSION_ID=                   # blank = random per run; scopes the egress report

# --- database --------------------------------------------------------------
POSTGRES_USER=solar
POSTGRES_DB=solar
POSTGRES_PASSWORD=localdev
