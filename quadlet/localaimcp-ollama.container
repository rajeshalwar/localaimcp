[Unit]
Description=localaimcp Ollama (local LLM, no route to the internet)
After=network-online.target localaimcp-netint.network
Wants=network-online.target

[Container]
ContainerName=ollama
Image=docker.io/ollama/ollama:0.34.0

# Internal network ONLY. This is the whole privacy claim, expressed as one
# line: the container running the model has no gateway off this machine.
# Do not add localaimcp-netext.network here.
Network=localaimcp-netint.network

Volume=localaimcp-ollama-models.volume:/root/.ollama
Environment=OLLAMA_HOST=0.0.0.0:11434
Environment=OLLAMA_KEEP_ALIVE=-1

[Service]
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
